{
  description = "Kalx: Kalshi CLI and read-only MCP server (per-crate Nix builds)";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs = { self, nixpkgs }:
    let
      systems = [ "x86_64-linux" "aarch64-linux" ];
      eachSystem = nixpkgs.lib.genAttrs systems;
      pkgsFor = system: import nixpkgs { inherit system; };
      packageFor = system:
        let
          pkgs = pkgsFor system;
          # Cargo.nix is generated by the pinned crate2nix in the dev shell.
          # No IFD, Crane or monolithic dependency compilation.
          cargoNix =
            if builtins.pathExists ./Cargo.nix then
              pkgs.callPackage ./Cargo.nix {
                buildRustCrateForPkgs = p: p.buildRustCrate.override {
                  defaultCrateOverrides = p.defaultCrateOverrides // {
                    aws-lc-sys = attrs:
                      let base = p.defaultCrateOverrides.aws-lc-sys attrs; in
                      base // {
                        nativeBuildInputs = (base.nativeBuildInputs or []) ++ [
                          p.perl p.pkg-config
                        ];
                      };
                  };
                };
              }
            else throw "Generate Cargo.nix first: nix develop --command crate2nix generate; git add Cargo.nix";
          root = cargoNix.rootCrate.build;
        in root.override {
          runTests = true;
          testPreRun = ''
            set -o pipefail
            export SSL_CERT_FILE="${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt"
          '';
        };
    in {
      packages = eachSystem (system:
        let package = packageFor system; in {
          default = package;
          kalx = package;
        });
      apps = eachSystem (system:
        let package = self.packages.${system}.default; in rec {
          default = kalx;
          kalx = { type = "app"; program = "${package}/bin/kalx"; };
          mcp = { type = "app"; program = "${package}/bin/kalx-mcp"; };
        });
      checks = eachSystem (system: { kalx = self.packages.${system}.default; });
      devShells = eachSystem (system:
        let pkgs = pkgsFor system; in {
          default = pkgs.mkShell {
            packages = with pkgs; [
              crate2nix cargo rustc rustfmt clippy rust-analyzer
              pkg-config cmake perl nix-output-monitor
            ];
            SSL_CERT_FILE = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
          };
        });
    };
}
